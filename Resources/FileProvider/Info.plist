<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- __PLACEHOLDERS__ are filled in by scripts/build-app.sh. -->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>__BUNDLE_ID__.fileprovider</string>
	<key>CFBundleExecutable</key>
	<string>ATDriveFileProvider</string>
	<key>CFBundleName</key>
	<string>ATDrive File Provider</string>
	<key>CFBundleDisplayName</key>
	<string>ATDrive</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__VERSION__</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.fileprovider-nonui</string>
		<key>NSExtensionPrincipalClass</key>
		<string>ATDriveFileProviderExtension</string>
		<key>NSExtensionFileProviderDocumentGroup</key>
		<string>__APP_GROUP__</string>
		<key>NSExtensionFileProviderSupportsEnumeration</key>
		<true/>
		<!-- Finder's sharing actions, by each item's userInfo.sharing (`SharingRole`). The action
		     identifier's last part names the request handed to the app (`SharingRequest`). -->
		<key>NSExtensionFileProviderActions</key>
		<array>
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>__BUNDLE_ID__.fileprovider.share</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>Share…</string>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>SUBQUERY ( fileproviderItems, $fileproviderItem, $fileproviderItem.userInfo.sharing IN {&quot;none&quot;, &quot;own&quot;, &quot;other&quot;} ).@count == 1 AND fileproviderItems.@count == 1</string>
			</dict>
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>__BUNDLE_ID__.fileprovider.copyLink</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>Copy Link</string>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>SUBQUERY ( fileproviderItems, $fileproviderItem, $fileproviderItem.userInfo.sharing IN {&quot;own&quot;, &quot;other&quot;} ).@count == 1 AND fileproviderItems.@count == 1</string>
			</dict>
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>__BUNDLE_ID__.fileprovider.stopSharing</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>Stop Sharing</string>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>SUBQUERY ( fileproviderItems, $fileproviderItem, $fileproviderItem.userInfo.sharing == &quot;own&quot; ).@count == 1 AND fileproviderItems.@count == 1</string>
			</dict>
		</array>
		<!-- Badges for shares (`Item.decorations`). -->
		<key>NSFileProviderDecorations</key>
		<array>
			<dict>
				<key>Identifier</key>
				<string>__BUNDLE_ID__.fileprovider.shared</string>
				<key>Category</key>
				<string>Sharing</string>
				<key>Label</key>
				<string>Shared</string>
				<key>BadgeImageType</key>
				<string>com.apple.icon-decoration.shared</string>
			</dict>
			<dict>
				<key>Identifier</key>
				<string>__BUNDLE_ID__.fileprovider.sharedWithMe</string>
				<key>Category</key>
				<string>Sharing</string>
				<key>Label</key>
				<string>Shared with you</string>
				<key>BadgeImageType</key>
				<string>com.apple.icon-decoration.shared</string>
			</dict>
			<!-- Spaces: a space some of which can't be read (`SpacesItem.decorations`). -->
			<dict>
				<key>Identifier</key>
				<string>__BUNDLE_ID__.fileprovider.unreadable</string>
				<key>Category</key>
				<string>Badge</string>
				<key>Label</key>
				<string>Can't be read</string>
				<key>BadgeImageType</key>
				<string>com.apple.icon-decoration.badge.warning</string>
			</dict>
		</array>
	</dict>
	<key>ATDriveAppGroup</key>
	<string>__APP_GROUP__</string>
</dict>
</plist>
